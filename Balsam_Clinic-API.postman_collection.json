                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/api/appointments/{{appointment_id}}/arrive"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
