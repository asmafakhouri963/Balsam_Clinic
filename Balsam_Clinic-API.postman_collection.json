{
  "info": {
    "_postman_id": "4f92b8c1-6a35-4e9d-b128-7c4e2d9a8053",
    "name": "Balsam Clinic API",
    "description": "API testing collection for Balsam Clinic management system.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Availability",
      "item": [
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reception_dam_token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/availability?doctor_id={{doctor_id}}&branch_id={{branch_id}}&date=2026-11-29",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "availability"
              ],
              "query": [
                {
                  "key": "doctor_id",
                  "value": "{{doctor_id}}"
                },
                {
                  "key": "branch_id",
                  "value": "{{branch_id}}"
                },
                {
                  "key": "date",
                  "value": "2026-11-29"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Available slots array returned', function () { pm.expect(Array.isArray(body.available_slots)).to.be.true; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Appointments",
      "item": [
        {
          "name": "List Appointments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
