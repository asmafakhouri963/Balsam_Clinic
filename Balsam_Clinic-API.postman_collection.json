          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reception_dam_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branch_id\": {{branch_id}},\n  \"doctor_id\": {{doctor_id}},\n  \"patient_id\": {{patient_id}},\n  \"appointment_date\": \"2026-11-29\",\n  \"start_time\": \"09:00\",\n  \"end_time\": \"09:30\",\n  \"notes\": \"حجز عبر Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/appointments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Appointment created with status 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "const appt = body.data || body;",
                  "if (appt.id) { pm.environment.set('appointment_id', appt.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark Appointment Arrived",
          "request": {
